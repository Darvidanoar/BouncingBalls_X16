# Build the Boing ball demo for the Commander X16.
#   make        - build BOING.PRG
#   make run    - build and start it in the emulator
#   make clean  - remove build output

CC       = cl65
CFLAGS   = -t cx16 -C cx16-asm.cfg -u __EXEHDR__
PROGNAME = BOING
X16EMU   = /home/david/Documents/CommanderX16/x16emu/x16emu

all: $(PROGNAME).PRG

$(PROGNAME).PRG: $(PROGNAME).ASM BALL_DATA.INC INC/x16.inc
	$(CC) $(CFLAGS) -o $(PROGNAME).PRG -l $(PROGNAME).LIST $(PROGNAME).ASM

# The ball image is generated by a Python script.
BALL_DATA.INC: gen_ball.py
	python3 gen_ball.py

run: $(PROGNAME).PRG
	$(X16EMU) -scale 2 -prg $(PROGNAME).PRG -run

clean:
	rm -f $(PROGNAME).PRG $(PROGNAME).LIST *.o
